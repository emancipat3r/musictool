# Copy to .env and fill in. NEVER commit .env (it is gitignored).

# --- Spotify (required) ---
# Public Client ID from the Spotify Developer Dashboard app (Web API, redirect
# URI exactly http://127.0.0.1:8888/callback). The client secret is NOT used.
SPOTIFY_CLIENT_ID=

# Headless bootstrap: run `spotifytool auth --print-refresh-token` once on any
# machine with a browser, paste the printed token here. PKCE rotates this token;
# the container persists rotations to its own token cache after first mint.
SPOTIFY_REFRESH_TOKEN=

# --- Last.fm (optional, discovery seeds) ---
LASTFM_API_KEY=

# --- Deployment ---
# LAN/tailnet interface to bind the dashboard and Zellij web to (never 0.0.0.0
# unless the host firewall blocks WAN). E.g. a Tailscale IP 100.x.y.z.
LAN_IP=

TZ=America/New_York

# Directory holding `tailscale cert` output (cert.pem/key.pem) for Zellij web.
ZELLIJ_CERT_DIR=./certs
