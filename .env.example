# Copy to .env and fill in. NEVER commit .env (it is gitignored).

# --- Spotify (required) ---
# Public Client ID from the Spotify Developer Dashboard app (Web API, redirect
# URI exactly http://127.0.0.1:8888/callback). The client secret is NOT used.
SPOTIFY_CLIENT_ID=

# Headless bootstrap: run `spotifytool auth --print-refresh-token` once on any
# machine with a browser, paste the printed token here. PKCE rotates this token;
# the container persists rotations to its own token cache after first mint.
SPOTIFY_REFRESH_TOKEN=

# --- Last.fm (optional, discovery seeds) ---
LASTFM_API_KEY=

# --- Deployment ---
# LAN/tailnet interface to bind the dashboard and Zellij web to (never 0.0.0.0
# unless the host firewall blocks WAN). E.g. a Tailscale IP 100.x.y.z.
LAN_IP=

TZ=America/New_York

# Optional: directory holding TLS certs (cert.pem/key.pem) for Zellij web,
# e.g. `tailscale cert` output. If none are present, the sandbox generates a
# self-signed pair automatically (one-time browser warning).
ZELLIJ_CERT_DIR=./certs

# Zellij web client URL for the dashboard's terminal pane. Defaults to
# https://LAN_IP:8082; set the tailnet hostname instead if you minted the cert
# for it (browsers won't trust an IP with a hostname cert).
#TERMINAL_URL=https://homelab.your-tailnet.ts.net:8082
