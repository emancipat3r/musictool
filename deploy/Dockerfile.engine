# Container 2 — the engine + dashboard. Builds the static musictool binary and
# runs `serve` (MCP over Streamable HTTP + read-only dashboard). Cron drives the
# hourly sync and weekly discovery batch.
#
# CGO_ENABLED=0 keeps the binary static so it runs on a scratch/distroless base.

FROM golang:1.26 AS build
WORKDIR /src
ENV CGO_ENABLED=0
COPY go.mod go.sum* ./
RUN go mod download
COPY . .
ARG VERSION=docker
RUN go build -ldflags "-s -w -X main.version=${VERSION}" -o /out/musictool ./cmd/musictool

# Runtime: small image with busybox cron + CA certs. This container is pure Go:
# no node, no Claude CLI, no model invocations of any kind. All Claude usage
# happens in the sandbox container's interactive session (Max subscription);
# the discovery batch is the /discovery-batch command run there.
FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata busybox-suid openssl
WORKDIR /app
COPY --from=build /out/musictool /usr/local/bin/musictool
COPY deploy/crontab /etc/crontabs/root

# Shared-volume defaults; override in compose if desired.
ENV MUSICTOOL_DATA_DIR=/data \
    MUSICTOOL_CONFIG_DIR=/data/config \
    MUSICTOOL_PROFILE=/data/taste-profile.md \
    MUSICTOOL_DIGEST_DIR=/data/digests \
    MUSICTOOL_MCP_ADDR=:8080 \
    MUSICTOOL_DASH_ADDR=:8081

EXPOSE 8080 8081
VOLUME ["/data"]

# Start crond (hourly sync + weekly batch) alongside the server.
COPY deploy/engine-entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh
ENTRYPOINT ["/app/entrypoint.sh"]
